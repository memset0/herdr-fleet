# Copy to: $(herdr plugin config-dir memset0.web-remote)/.env
# This file is device-local. Keep it mode 0600 and never commit credentials.

# The Bridge remains loopback-only behind the Web Remote Gateway/reverse proxy.
COLLIE_HOST=127.0.0.1
COLLIE_PORT=8787
COLLIE_SKIP_SERVE=1
COLLIE_PUBLIC_HOSTS=local.herdr.example.com
COLLIE_ALLOWED_ORIGINS=https://local.herdr.example.com
COLLIE_MULTI_SESSION=1

# The upstream bridge refuses a non-loopback bind unless this explicit escape hatch is enabled.
# Web Remote does not need it in its supported deployment model.
# COLLIE_ALLOW_NON_LOOPBACK_BIND=1

# Optional Herdr transport and polling controls.
# COLLIE_HERDR_DIAL=auto
# COLLIE_POLL_MS=1500
# COLLIE_POLL_IDLE_MS=12000
# COLLIE_READ_LINES=200
# COLLIE_SUBMIT_KEYS=Enter

# Optional Pane transcript roots. Each setting accepts one directory or several comma-separated
# directories searched in order; every read remains contained within the matching root.
# COLLIE_TRANSCRIPT=on
# COLLIE_TRANSCRIPT_ROOT=/home/operator/.claude/projects,/home/operator/.claude-work/projects
# COLLIE_CODEX_ROOT=/home/operator/.codex/sessions
# COLLIE_PI_ROOT=/home/operator/.pi/agent/sessions
# COLLIE_OPENCODE_ROOT=/home/operator/.local/share/opencode
# COLLIE_GROK_ROOT=/home/operator/.grok/sessions

# Operator-defined command, key, and quick-reply TOML files live beside this .env. Start from the
# corresponding repository examples; the Bridge hot-reloads their last valid contents.

# Optional write authorization injected by a trusted loopback reverse proxy. When the header is
# configured, requests without an allowlisted value are read-only. An empty allowlist fails closed.
# COLLIE_DEVICE_HEADER=X-Device-Id
# COLLIE_DEVICE_ALLOWLIST=my-phone,my-laptop

# These upstream safety controls remain available, although the Gateway is Web Remote's normal
# authentication boundary. Never trust client-supplied identity headers on a directly reachable
# Bridge listener.
# COLLIE_TRUSTED_USER=operator@example.com
# COLLIE_TRUSTED_USER_OPTIONAL=1
# COLLIE_ALLOW_ANY_HOST=1

# Optional action-audit content policy. `preview` (default) retains bounded previews; `none` redacts
# string content except safe structural fields allowlisted by the bridge.
# COLLIE_AUDIT_CONTENT=none

# Optional Web Push credentials. Generate them with a trusted one-shot tool and keep the private key
# only in this mode-0600 device-local file.
# COLLIE_VAPID_PUBLIC=
# COLLIE_VAPID_PRIVATE=
# COLLIE_VAPID_SUBJECT=mailto:operator@example.com

# Public routing metadata used only by the optional focused-Pane copy shortcut.
HERDR_WEB_FLEET_URL=https://herdr.example.com/
HERDR_WEB_INSTANCE_ID=local

# Set only on the host that runs the Fleet Gateway. Other nodes run only Collie.
# HERDR_WEB_GATEWAY_CONFIG=/absolute/path/to/gateway.json

# Optional shared-HOME protection: only hostnames with this prefix may own the daemon.
# HERDR_WEB_HOST_PREFIX=stable-login
HERDR_WEB_DISALLOW_JOBS=1

# Supervisor liveness policy.
HERDR_WEB_HEALTH_INTERVAL_MS=15000
HERDR_WEB_INACTIVE_GRACE_MS=60000
