{
  "schema": 3,
  "nodes": {
    "local-a": {
      "platform": "linux",
      "architecture": "x86_64",
      "owner": "operator",
      "herdr_owner": "operator",
      "python": "/usr/bin/python3",
      "host_exact": "workstation-a",
      "herdr": "/usr/local/bin/herdr",
      "session": null,
      "server_socket": "/home/operator/.config/herdr/herdr.sock",
      "runtime_dir": "/run/user/1000/herdr-web-remote-ttyd",
      "install_root": "/home/operator/.local/libexec/herdr-web-remote/ttyd-fallback",
      "binary": {
        "source": "release_asset"
      },
      "transport": {
        "kind": "local"
      }
    },
    "cluster-a": {
      "platform": "linux",
      "architecture": "aarch64",
      "owner": "operator",
      "herdr_owner": "operator",
      "python": "/usr/bin/python3",
      "host_prefix": "login-",
      "reject_slurm": true,
      "herdr": "/home/operator/.local/bin/herdr",
      "session": "cluster-a",
      "server_socket": "/tmp/cluster-a-herdr/herdr.sock",
      "runtime_dir": "/tmp/herdr-web-remote-ttyd-operator",
      "install_root": "/home/operator/.local/libexec/herdr-web-remote/ttyd-fallback",
      "binary": {
        "source": "release_asset"
      },
      "transport": {
        "kind": "ssh",
        "host": "cluster-a.internal.example",
        "port": 22,
        "user": "operator",
        "identity": "ssh/cluster-a-fallback",
        "known_hosts": "ssh/cluster-a-known-hosts"
      }
    }
  }
}
