{
  "name": "herdr-plugin-web-remote",
  "version": "2.1.1",
  "private": true,
  "license": "MIT",
  "description": "Authenticated Fleet dashboard and Collie-based remote UI for Herdr",
  "type": "module",
  "scripts": {
    "start": "bun run supervisor/control.ts ensure",
    "dev": "bun --watch bridge/index.ts",
    "build": "bash scripts/build.sh",
    "build:web": "cd web && bun run build",
    "web:dev": "cd web && bun run dev",
    "test": "bun test ./bridge ./gateway ./supervisor",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "web-push": "^3.6.7"
  }
}
